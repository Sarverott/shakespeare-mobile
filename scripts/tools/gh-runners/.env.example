# Copy to .env (git-ignored) to change the defaults. All values are optional.
# REPOSITORY=Sarverott/shakespeare-mobile
# RUNNERS=1
# RUNNER_LABELS=shakespeare,android
# RUNNER_PREFIX=shakespeare
# ACCESS_TOKEN=            # leave unset to use `gh auth token`; a fine-grained PAT with
#                          # "Administration: read and write" on the repo is the least privilege
